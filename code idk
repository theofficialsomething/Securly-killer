        throw new Error("That import is not a full link. It should start with https://github.com/");
      }
      if (url.protocol !== "https://github.com/schoolexploitkid/UNBLOCK3R.git") {
        throw new Error("The link has to start with https://");
      }
      if (url.hostname === "github.com") {
        const parts = url.pathname.split("/").filter(Boolean);
        const marker = parts.findIndex(function (part) {
          return part === "blob" || part === "raw";
        });
        if (marker < 2 || parts.length < marker + 3) {
          throw new Error("Paste the GitHub link to the HTML file itself. A link to the whole repository will not load here.");
        }
        const owner = parts[0];
        const repo = parts[1];
        const branch = parts[marker + 1];
        const path = parts.slice(marker + 2).join("/");
        const raw = "https://raw.githubusercontent.com/" + owner + "/" + repo + "/" + branch + "/" + path;
        return { raw: raw, base: raw.replace(/[^/]*$/, "") };
      }
      if (url.hostname === "raw.githubusercontent.com") {
        const parts = url.pathname.split("/").filter(Boolean);
        if (parts.length < 4) {
          throw new Error("Paste a link to a file.");
        }
        return { raw: url.href, base: url.href.replace(/[^/]*$/, "") };
      }
      throw new Error("Use an https://github.com link to your HTML file.");
    }
    function cdnUrl(raw) {
      const match = raw.match(/^https:\/\/raw\.githubusercontent\.com\/([^/]+)\/([^/]+)\/([^/]+)\/(.+)$/);
      if (!match) return "";
      return "https://cdn.jsdelivr.net/gh/" + match[1] + "/" + match[2] + "@" + match[3] + "/" + match[4];
    }
    function isExample(url) {
      return url.indexOf("your-name") !== -1 || url.indexOf("your-repo") !== -1;
    }
    function showMessage(text) {
      view.hidden = true;
      view.removeAttribute("src");
      view.srcdoc = "";
      hint.hidden = false;
      hint.textContent = text;
    }
    function showFrame(githubUrl) {
      hint.hidden = true;
      view.hidden = false;
      from.textContent = githubUrl;
    }
    async function openSite(name, githubUrl, button) {
      document.querySelectorAll("#bar button").forEach(function (item) {
        item.classList.remove("active");
      });
      button.classList.add("active");
      from.textContent = githubUrl;
      if (!githubUrl || isExample(githubUrl)) {
        showMessage("This button is the example. Open index.html, change the name and the https://github.com link inside the SITES list, save, and refresh.");
        return;
      }
      let parsed;
      try {
        parsed = parseGithub(githubUrl);
      } catch (error) {
        showMessage(error.message);
        return;
      }
      showMessage("Loading " + name + "…");
      try {
        const response = await fetch(parsed.raw);
        if (!response.ok) {
          throw new Error("missing");
        }
        const html = await response.text();
        const doc = new DOMParser().parseFromString(html, "text/html");
        if (!doc.querySelector("base")) {
          const base = doc.createElement("base");
          base.href = parsed.base;
          doc.head.prepend(base);
        }
        doc.querySelectorAll("[target]").forEach(function (el) {
          if ((el.getAttribute("target") || "").toLowerCase() === "_blank") {
            el.setAttribute("target", "_self");
          }
        });
        view.removeAttribute("src");
        view.srcdoc = "<!DOCTYPE html>\n" + doc.documentElement.outerHTML;
        showFrame(githubUrl);
      } catch (error) {
        const fallback = cdnUrl(parsed.raw);
        if (!fallback) {
          showMessage("Could not load that file inside this page. Check the GitHub link, save, and refresh.");
          return;
        }
        view.srcdoc = "";
        view.src = fallback;
        showFrame(githubUrl);
      }
    }
    const sites = document.querySelector("#sites");
    let pendingName = "";
    sites.content.childNodes.forEach(function (node) {
      if (node.nodeType === Node.COMMENT_NODE) {
        pendingName = buttonName(node) || pendingName;
        return;
      }
      if (node.nodeType !== Node.ELEMENT_NODE || node.tagName !== "SCRIPT") return;
      const githubUrl = readImport(node);
      const name = node.getAttribute("data-name") || pendingName || "Site";
      pendingName = "";
      const button = document.createElement("button");
      button.type = "button";
      button.textContent = name;
      button.addEventListener("click", function () {
        openSite(name, githubUrl, button);
      });
      bar.appendChild(button);
    });
    if (!bar.children.length) {
      showMessage("No websites yet. Open index.html and follow the notes at the top. Paste each site inside the SITES list.");
    }
  </script>
